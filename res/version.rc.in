#include <winver.h>

// The first icon is the exe's icon in Explorer; FloatBar also loads it for the
// tray and its windows. Built from assets/FloatBar_icon.png by tools/make-icon.ps1.
1 ICON "@CMAKE_SOURCE_DIR@/assets/floatbar.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Zyneq"
            VALUE "FileDescription",  "FloatBar - floating split taskbar for Windows 11"
            VALUE "FileVersion",      "@FB_VERSION@"
            VALUE "InternalName",     "floatbar"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Zyneq. MIT License."
            VALUE "OriginalFilename", "floatbar.exe"
            VALUE "ProductName",      "FloatBar"
            VALUE "ProductVersion",   "@FB_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
